rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)/members/$(request.auth.uid));
    }

    function isMember(listId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/lists/$(listId)/members/$(request.auth.uid));
    }

    function isOwner(listId) {
      return isMember(listId) && memberDoc(listId).data.role == 'owner';
    }

    // LIST-05: アーカイブ中・削除済みのリストは読み取り専用にする
    // (再開にはアクティブ化/復元がFunctions経由で必要)。
    function isListActive(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId)).data;
      return list.archivedAt == null && list.deletedAt == null;
    }

    // AUTH-001: 本人のみusers/{uid}を読み書きできる。
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // LIST-001: 一覧用の非正規化参照。集計値の整合はサーバーが持つため、
      // 読取のみ許可し、作成・更新はCallable Functions(Admin SDK)に限る。
      match /listRefs/{listId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // LIST-001: リスト本体。閲覧はメンバーのみ。
    // 作成・アーカイブ解除・削除はFree上限や所有権の原子的判定が要るため
    // Callable Functions(Admin SDK)へ寄せ、client writeは拒否する。
    match /lists/{listId} {
      allow read: if isMember(listId);
      allow create, delete: if false;
      // 名前・色・アイコンなど表示用の情報だけをメンバー(オーナー・編集者)が
      // 直接更新できる(仕様2.3)。所有者やアーカイブ状態の変更はFunctions経由に
      // 限る。アーカイブ中は読み取り専用のため、resource.data(更新前の値)で判定する。
      allow update: if isMember(listId) &&
        resource.data.archivedAt == null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'color', 'icon', 'updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.color is string &&
        request.resource.data.color.size() >= 1 &&
        request.resource.data.icon is string &&
        request.resource.data.icon.size() >= 1;

      // 項目CRUDはオフラインで完結する必要があるためclient writeを許可する。
      // ただしアーカイブ中・削除済みのリストは読み取り専用にする(LIST-05)。
      match /items/{itemId} {
        allow read: if isMember(listId);
        allow create: if isMember(listId) &&
          isListActive(listId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.deletedAt == null;
        // 論理削除で運用するため物理削除は許可しない(30日後にサーバーが消す)。
        allow update: if isMember(listId) &&
          isListActive(listId) &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      // メンバー構成の変更は招待・所有権移譲の検証を伴うためFunctionsに限る。
      // メンバー削除・退出もmembersドキュメントの削除で権限を即時失効させるが、
      // 最後のownerを守る検証が要るためFunctions経由に限る(SHARE-004)。
      match /members/{uid} {
        allow read: if isMember(listId);
        allow write: if false;
      }
    }

    // SHARE-002: 招待。トークンの平文は保存せずドキュメントIDはそのハッシュ。
    // オーナーだけが自分のリストの招待メタデータ(有効期限・取消状態)を
    // `listId == X` で絞って読める。作成・取消・受諾の検証はFunctions(Admin SDK)
    // に限り、非メンバーへのプレビューもgetInvitePreview経由で返す。
    match /invites/{inviteId} {
      allow read: if isOwner(resource.data.listId);
      allow write: if false;
    }
  }
}
