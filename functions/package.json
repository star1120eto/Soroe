{
  "name": "functions",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/rules/**'",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run src/rules'",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.28.1",
    "firebase-tools": "^15.24.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
