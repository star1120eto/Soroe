{
  "name": "functions",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/rules/**' --exclude 'src/integration/**'",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run src/rules src/integration'",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "seed": "node scripts/seed-emulator.mjs",
    "templates:validate": "node scripts/official-templates.mjs validate",
    "templates:seed": "node scripts/official-templates.mjs seed",
    "ai:eval": "esbuild ai-eval/run.ts --bundle --platform=node --format=cjs --alias:@soroe/shared=../packages/shared/src/index.ts --outfile=lib/ai-eval.cjs --log-level=warning && node lib/ai-eval.cjs"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.28.1",
    "firebase-tools": "^15.24.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
