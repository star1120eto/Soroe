# dependencies
node_modules/

# pnpm
.pnpm-store/

# build output
functions/lib/
packages/*/dist/

# expo
apps/mobile/.expo/*
apps/mobile/dist/
apps/mobile/web-build/

# .expo/types/router.d.ts is static per route tree and tracked so CI's tsc
# can resolve typed routes without running `expo start` first.
!apps/mobile/.expo/types/

# native
apps/mobile/ios/
apps/mobile/android/

# firebase client config (fetch from Firebase console per environment)
apps/mobile/GoogleService-Info.plist
apps/mobile/google-services.json

# env
.env
.env.local
*.local

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# os / editor
.DS_Store
*.log

# claude code local settings
.claude/settings.local.json
