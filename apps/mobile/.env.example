# Copy to .env.local and fill in per environment. Values prefixed EXPO_PUBLIC_
# are inlined into the client bundle, so only put public-safe values here.

EXPO_PUBLIC_APP_ENV=development

# RevenueCat public SDK keys (safe to embed client-side). Obtain from the
# RevenueCat project dashboard once the account/project exist.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Firebase Web App設定。Web版のみ使用、iOS/Androidは不要(plist/json自動初期化)。
# 取得先: Firebase console → プロジェクト設定 → 全般 → マイアプリ → ウェブアプリ
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_WEB_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_WEB_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_WEB_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
